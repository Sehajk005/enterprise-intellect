# Copy this file to .env and fill in the two keys below.
# Everything else already has a working default for local development.

## App
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

## Database
# pragma: allowlist nextline secret
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_intellect

## Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_TOKEN_TTL_MIN=10
PASSKEY_MAX_ATTEMPTS=5
PASSKEY_LOCK_MIN=15
INVITE_TTL_DAYS=7

## Seed (first org/admin created by backend/scripts/seed.py)
SEED_ORG_NAME=Acme Corp
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-123

## Gemini — REQUIRED: get a key from Google AI Studio
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
LLM_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1024

## Pinecone — REQUIRED: get a key and create the serverless index from 0.1.3
PINECONE_API_KEY=
PINECONE_INDEX=enterprise-intellect
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

## RAG (retrieval/grounding — tuned from the first evaluation run, see Evaluation Protocol)
TOP_K=5
SIMILARITY_THRESHOLD=0.5
HISTORY_MESSAGES=6
CHUNKER=v1
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

## Files
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
SUMMARY_MAX_TOKENS=30000
